# Shared PostgreSQL database (same connection string as mobile/backend)
DATABASE_URL=postgresql://balagh:balagh@localhost:5432/balagh

# Operator Bearer token — required on every request except /health
OPERATOR_TOKEN=change-this-secret

# Server port (distinct from mobile/backend which uses 3000)
PORT=4000

# Dashboard origin for CORS (never use * in production)
DASHBOARD_ORIGIN=http://localhost:5173

# Pino log level
LOG_LEVEL=info
