# Set to false to connect to the real web/backend instead of using mock data
VITE_USE_MOCK=false

# URL of the web/backend service (must match web/backend PORT in its .env)
VITE_API_BASE_URL=http://localhost:4000

# WebSocket URL of the web/backend (operator realtime feed)
VITE_WS_URL=ws://localhost:4000/ws
